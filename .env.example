# ========================================================
# OmniStore E-Commerce BI Suite - Environment Configuration
# Copy this file to .env and customize for your deployment
# ========================================================

# Flask Session Security Key
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars

# Database Engine Selection ('sqlite' or 'mysql')
BI_DB_TYPE=sqlite

# MySQL Database Connection Parameters (used if BI_DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ecommerce_bi

# Default Demo Account (Automatically initialized if user table is empty)
# Email: admin@omnistore.bi
# Password: Admin123!
